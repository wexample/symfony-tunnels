{
  "name": "wexample/symfony-tunnels",
  "description": "A tunnels service for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "2.0.3",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyTunnels\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyTunnels\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "wexample/symfony-helpers": ">=9.0.0",
    "wexample/symfony-forms": ">=7.0.0",
    "wexample/symfony-translations": ">=4.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "*",
    "wexample/symfony-testing": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
