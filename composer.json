{
  "name": "wexample/symfony-tunnels",
  "description": "A tunnels service for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "11.0.3",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyTunnels\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyTunnels\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "wexample/symfony-helpers": ">=18.0.0",
    "wexample/symfony-forms": ">=14.0.0",
    "wexample/symfony-translations": ">=17.0.0",
    "wexample/php-pseudocode": ">=2.2.0",
    "wexample/symfony-pseudocode": ">=4.0.0",
    "wexample/symfony-seo": ">=10.0.0",
    "symfony/form": "^7.4",
    "symfony/scheduler": "^7.4 || ^8.0",
    "symfony/messenger": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=2.0.0",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}